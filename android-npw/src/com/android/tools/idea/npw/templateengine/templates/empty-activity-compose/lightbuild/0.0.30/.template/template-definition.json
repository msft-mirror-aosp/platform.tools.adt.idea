{
  "name" : "Empty Activity",
  "short-name" : "empty-activity-lightbuild",
  "tags" : ["compose", "activity", "lightbuild"],
  "arguments" : [
    {
      "id" : "name",
      "description": "The application display name on the Android Device",
      "default-value" : "My Application"
    },
    {
      "id" : "applicationId",
      "description": "The application ID for the Gradle Android Plugin, i.e. the Android package name of the application",
      "default-value" : "com.example.${name.toAndroidPackageSegment()}"
    },
    {
      "id" : "namespace",
      "description": "The namespace for resources and package name for Kotlin source files",
      "default-value" : "com.example.${name.toJavaPackageSegment()}"
    },
    {
      "id" : "minSdk",
      "description": "The 'minSdk' for this application",
      "default-value" : "24"
    },
    {
      "id" : "compileSdk",
      "description" : "The 'compileSdk' used to compile this application",
      "default-value" : "36"
    }
  ],
  "dependencies" : [
    {
      "sdk-package" : "platforms/android-${compileSdk}"
    }
  ],
  "transformations" : [
    {
      "string-replace" : {
        "description" : "Replace the Android application name in the project file",
        "selector" : {
          "glob" : "/project.lightbuild.yaml"
        },
        "from" : "name: My Application",
        "to" : "name: ${name}"
      }
    },
    {
      "string-replace" : {
        "description" : "Replace the Android application name strings.xml",
        "selector" : {
          "glob" : "/app-core/src/main/res/values/strings.xml"
        },
        "from" : "My Application",
        "to" : "${name.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('\\\\', '\\\\\\\\').replace(\"'\", \"\\\\'\").replace('\"', '\\\\\"')}"
      }
    },
    {
      "string-replace" : {
        "description": "Replace the 'minSdk' in the app module lightbuild file.",
        "example": [
          "  minSdk:",
          "    version:",
          "      release:",
          "        apiLevel: 24"
        ],
        "selector" : {
          "glob" : "/*/lightbuild.yaml"
        },
        "from" : "  minSdk:\n    version:\n      release:\n        apiLevel: 24",
        "to" : "  minSdk:\n    version:\n      release:\n        apiLevel: ${minSdk}"
      }
    },
    {
      "string-replace" : {
        "description": "Replace the 'compileSdk' in the app module lightbuild file",
        "example": [
          "  compileSdk:",
          "    version:",
          "      release:",
          "        apiLevel: 36"
        ],
        "selector" : {
          "glob" : "/*/lightbuild.yaml"
        },
        "from" : "  compileSdk:\n    version:\n      release:\n        apiLevel: 36",
        "to" : "  compileSdk:\n    version:\n      release:\n        apiLevel: ${compileSdk}"
      }
    },
    {
      "string-replace" : {
        "description": "Replace the 'targetSdk' in the app module lightbuild file",
        "example": [
          "  targetSdk:",
          "    version:",
          "      release:",
          "        apiLevel: 36"
        ],
        "selector" : {
          "glob" : "/app/lightbuild.yaml"
        },
        "from" : "  targetSdk:\n    version:\n      release:\n        apiLevel: 36",
        "to" : "  targetSdk:\n    version:\n      release:\n        apiLevel: ${compileSdk}"
      }
    },
    {
      "string-replace" : {
        "description": "Replace the Android application ID in the app module lightbuild file",
        "selector" : {
          "glob" : "/app/lightbuild.yaml"
        },
        "from" : "applicationId: com.example.myapplication",
        "to" : "applicationId: ${applicationId}"
      }
    },
    {
      "string-replace" : {
        "description" : "Replace the namespace directive in all lightbuild file",
        "selector" : {
          "glob" : "**/*lightbuild.yaml"
        },
        "from" : "namespace: com.example.myapplication",
        "to" : "namespace: ${namespace}"
      }
    },
    {
      "string-replace" : {
        "description" : "Replace any kotlin reference in all kotlin files",
        "selector" : {
          "glob" : "**/*.kt"
        },
        "from" : "com.example.myapplication",
        "to" : "${namespace}"
      }
    },
    {
      "rename-file" : {
        "description" : "Move kotlin files to the directory corresponding to the package name",
        "selector" : {
          "glob" : "**/*.kt"
        },
        "source-path" : "com/example/myapplication",
        "target-path" : "${namespace.replace('.','/')}"
      }
    },
    {
      "string-replace": {
        "description": "Replace compose theme name",
        "selector": {
          "glob": "**/*.kt"
        },
        "from": "MyApplicationTheme",
        "to": "${name.toJavaClassName()}Theme"
      }
    },
    {
      "string-replace": {
        "description": "Replace theme name in themes.xml",
        "selector": {
          "glob": "/app-core/src/main/res/values/themes.xml"
        },
        "from": "Theme.MyApplication",
        "to": "Theme.${name.toJavaClassName()}"
      }
    },
    {
      "string-replace": {
        "description": "Replace theme name in AndroidManifest.xml",
        "selector": {
          "glob": "/app/src/main/AndroidManifest.xml"
        },
        "from": "Theme.MyApplication",
        "to": "Theme.${name.toJavaClassName()}"
      }
    }
  ]
}
